# --- The originals. Real practices, real people, real work emails. ------------
# Default-deny inside dental-demo/: only the demo site itself is public. The
# prospect data lives here untouched on disk and is published only as the
# anonymised copies in pipeline/, generated by redact.py.
dental-demo/*
!dental-demo/index.html
!dental-demo/assets/
!dental-demo/vercel.json

# Session handoff notes - names the real domains and the enriched work email.
HANDOFF.md

# Raw terminal scrollback of the build sessions. Same problem, 240 KB of it.
.ignore/

# Screenshot of a Clay OAuth consent screen tied to this workspace.
clay_authorize.jpg

# Someone else's repository (github.com/Samin12/ai-storyboard-video-starter),
# vendored locally for a later use case. 315 MB, and not ours to redistribute.
ai-storyboard-video-starter-main/

# Transcript of the source video - not ours to republish. The URL is in README.
docs/transcript.txt

# Vercel project/org ids.
.vercel/

# The alias mapping itself is an identifier: it maps Practice A back to a real
# practice. redact.py falls back to plain file-order labels without it.
redaction-keys.json

# Screenshots, transcript notes and prompts lifted from the source video - not
# ours to republish, and the notes name a real practice by domain. The video is
# linked from README.md instead.
docs/

__pycache__/

# Screenshots of Clay account pages pasted in during review.
clay_usage.jpg

# Originals of the second-city run. Same rule as dental-demo/: the real
# practices stay here, and only the anonymised copies in pipeline-mountain-view/
# are published.
mountain-view/

# The claymation ad - not reviewed/approved for publication yet.
claymation-ad/

# The Phoenix med spa scroll-world build. Same rule as claymation-ad/: generated
# media stays local until it has been reviewed and the fictional-business banner
# is in place. provenance.json records how each file was made.
medspa-world/

# Originals of the third run (Phoenix/Scottsdale med spas). Same rule as
# mountain-view/: the real businesses stay here and only the redactor's output
# is ever published.
phoenix/
